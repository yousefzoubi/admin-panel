### Login
# @name login

POST http://localhost:9999/login
Content-Type: application/json

{
  "email": "ali@example.com",
  "password": "123456"
}

###
POST http://localhost:9999/login/verify-otp
Content-Type: application/json

{
  "userId": 39,
  "otp": "266127"
}


> {%
    client.global.set("adminToken", response.body.accessToken);
    client.global.set("adminRefreshToken", response.body.refreshToken);

    // Optional generic variables
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### Login as second user
# @name loginUser2

POST http://localhost:9999/login
Content-Type: application/json

{
  "email": "eeee@example.com",
  "password": "123456"
}

> {%
    client.global.set("user2Token", response.body.accessToken);
%}




